# ==============================================================================
# Databases & SQL Container Environment Variables (.env)
# (OrbStack & Podman 호환 환경 설정)
# ==============================================================================

# 1. MySQL 8.4 LTS
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=practice_db
MYSQL_USER=practice
MYSQL_PASSWORD=practice

# 2. PostgreSQL 17
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=practice_db

# 3. Oracle 23ai Free
ORACLE_PORT=11521
ORACLE_PASSWORD=root
APP_USER=practice
APP_USER_PASSWORD=practice

# 4. MongoDB 7.0
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root
MONGO_DATABASE=practice_db

# 5. MS SQL Server (Azure SQL Edge - Mac ARM/Apple Silicon 최적화)
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_SA_PASSWORD=MakeAStrong!Passw0rd
